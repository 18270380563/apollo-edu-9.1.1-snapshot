# Define all coms in DAG streaming.
module_config {
    module_library : "modules/drivers/lidar/rslidar/librslidar_component.so"

    ##################################################
    #                   drivers                      #
    ##################################################
    components {
      class_name : "RslidarComponent"
      config {
        name : "robo_left_driver"
        config_file_path : "/apollo/modules/drivers/lidar/conf/lidar16_left.conf"
      }
    }
    components {
      class_name : "RslidarComponent"
      config {
        name : "robo_right_driver"
        config_file_path : "/apollo/modules/drivers/lidar/conf/lidar16_right.conf"
      }
    }
    components {
      class_name : "RslidarComponent"
      config {
        name : "robo_back_driver"
        config_file_path : "/apollo/modules/drivers/lidar/conf/lidar16_back.conf"
      }
    }
}

##################################################
#                   fusion and compensation                      #
##################################################
module_config {
    module_library : "modules/drivers/lidar_fusion_and_compensator/liblidar_fusion_and_compensator_component.so"
    components {
      class_name : "FusionAndCompensatorComponent"
      config {
        name : "fusion_and_compensator"
        config_file_path : "/apollo/modules/drivers/lidar/conf/lidar_fusion_and_compensator.pb.txt"
        readers {channel: "/apollo/sensor/lidar16/back/PointCloud2"}
      }
    }
}